ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Public site URL, used for SEO metadata, sitemap.xml, and robots.txt.
NEXT_PUBLIC_SITE_URL=https://www.drillpitch.com

# Google Search Console verification: Search Console > Settings > Ownership
# verification > HTML tag method > copy just the "content" value (not the
# full <meta> tag) here. Redeploy, then click Verify in Search Console.
GOOGLE_SITE_VERIFICATION=

# Optional: Bing Webmaster Tools verification code (same idea as above).
BING_SITE_VERIFICATION=
